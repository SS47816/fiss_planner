<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>frenet_planner_ros1</name>
  <version>1.0.0</version>
  <description>ROS 1 (Noetic) local planner (FOP, FOP+, FISS, FISS+) and MPC/Stanley controller nodes.</description>
  <maintainer email="ss1057532022@gmail.com">Shuo Sun</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/SS47816/frenet_planner</url>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>frenet_planner</depend>
  <depend>frenet_planner_msgs</depend>
  <depend>roscpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>dynamic_reconfigure</depend>
  <depend>lanelet2_core</depend>
  <depend>lanelet2_io</depend>
  <depend>lanelet2_projection</depend>
  <depend>lanelet2_routing</depend>
  <depend>lanelet2_traffic_rules</depend>

  <test_depend>rostest</test_depend>
  <test_depend>lanelet2_maps</test_depend>
</package>
