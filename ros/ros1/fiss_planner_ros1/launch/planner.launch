<?xml version="1.0"?>
<launch>
  <arg name="odom" default="/odom"/>
  <arg name="obstacles" default="/perception/obstacles"/>
  <arg name="reference_path" default="/planning/reference_path"/>
  <arg name="goal" default="/move_base_simple/goal"/>
  <arg name="lanelet2_map" default=""/>
  <arg name="planner" default="fiss_plus"/>
  <arg name="controller" default="false"/>
  <arg name="reconfigure_gui" default="false"/>

  <node pkg="fiss_planner_ros1" type="planner_node" name="fiss_planner" output="screen">
    <param name="odom_to_center_offset" value="1.35"/>
    <param name="publish_candidates" value="true"/>
    <param name="planner_type" value="$(arg planner)"/>
    <param name="map/lanelet2_path" value="$(arg lanelet2_map)"/>
    <remap from="~odom" to="$(arg odom)"/>
    <remap from="~obstacles" to="$(arg obstacles)"/>
    <remap from="~reference_path" to="$(arg reference_path)"/>
    <remap from="~goal" to="$(arg goal)"/>
  </node>

  <node if="$(arg controller)" pkg="fiss_planner_ros1" type="controller_node" name="fiss_controller" output="screen">
    <param name="controller" value="mpc"/>
    <param name="odom_to_center_offset" value="1.35"/>
    <remap from="~odom" to="$(arg odom)"/>
    <remap from="~trajectory" to="/fiss_planner/trajectory"/>
  </node>

  <node if="$(arg reconfigure_gui)" pkg="rqt_reconfigure" type="rqt_reconfigure" name="rqt_reconfigure"/>
</launch>
