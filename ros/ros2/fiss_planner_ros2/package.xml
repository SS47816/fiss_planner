<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fiss_planner_ros2</name>
  <version>1.1.0</version>
  <description>ROS 2 local planner (FOP, FOP+, FISS, FISS+) and MPC/Stanley controller nodes.</description>
  <maintainer email="ss1057532022@gmail.com">Shuo Sun</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/SS47816/fiss_planner</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>fiss_planner</depend>
  <depend>fiss_planner_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>lanelet2_core</depend>
  <depend>lanelet2_io</depend>
  <depend>lanelet2_projection</depend>
  <depend>lanelet2_routing</depend>
  <depend>lanelet2_traffic_rules</depend>

  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>lanelet2_maps</test_depend>
  <test_depend>ament_index_cpp</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
